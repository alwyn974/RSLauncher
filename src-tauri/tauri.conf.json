{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSLauncher",
  "version": "0.2.0",
  "identifier": "re.alwyn974.rslauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RSLauncher",
        "width": 1024,
        "height": 768,
        "minWidth": 854,
        "minHeight": 480,
        "center": false,
        "closable": true,
        "focus": true,
        "fullscreen": false,
        "maximizable": true,
        "resizable": true,
        "maximized": false,
        "minimizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQzk3MzU4NjBDQUQ0RUEKUldUcTFNcGdXSFBKL0FPOUVtTi9pNGoyK1FzTEE3dTErZFlHZHdPeldjWWMrbnNRYzVtUXF1SnAK",
      "endpoints": [
        "https://github.com/alwyn974/RSLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
