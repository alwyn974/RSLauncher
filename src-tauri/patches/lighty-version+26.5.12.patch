+    #[cfg(feature = "modrinth")]
+    pub fn with_modrinth_connector_mods<S>(mut self, list: Vec<(S, Option<String>)>) -> Self
+    where
+        S: Into<String>,
+    {
+        for (id_or_slug, version) in list {
+            self.pending.push(ModRequest::Modrinth {
+                id_or_slug: id_or_slug.into(),
+                version,
+                via_connector: true,
             });
         }
         self
