+
+/// CDN fallback when CurseForge returns `downloadUrl: null` (third-party
+/// distribution disabled). Same construction as FlowUpdater:
+/// `https://edge.forgecdn.net/files/{fileId[0..4]}/{fileId[4..]}/{fileName}`
+///
+/// See <https://github.com/FlowArg/FlowUpdater/blob/master/src/main/java/fr/flowarg/flowupdater/integrations/curseforgeintegration/CurseForgeIntegration.java#L125>
+pub fn forgecdn_download_url(file_id: u32, file_name: &str) -> String {
+    let id = file_id.to_string();
+    let (prefix, suffix) = if id.len() >= 4 {
+        (&id[..4], &id[4..])
+    } else {
+        (id.as_str(), "")
+    };
+    let name = file_name.replace(' ', "%20");
+    format!("https://edge.forgecdn.net/files/{prefix}/{suffix}/{name}")
+}
+
+/// Prefer the API `downloadUrl`, else the ForgeCDN fallback above.
+pub fn resolve_file_download_url(file_id: u32, file_name: &str, download_url: Option<&str>) -> String {
+    match download_url {
+        Some(url) if !url.is_empty() => url.to_string(),
+        _ => {
+            let fallback = forgecdn_download_url(file_id, file_name);
+            lighty_core::trace_warn!(
+                file_id,
+                file_name,
+                %fallback,
+                "CurseForge downloadUrl missing - using ForgeCDN fallback"
+            );
+            fallback
+        }
+    }
+}
