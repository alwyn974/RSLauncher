+/// Under Connector, Fabric mods on Forge/NeoForge resolve as Fabric.
+fn effective_loader(loader: &Loader, via_connector: bool) -> Loader {
+    if via_connector {
+        match loader {
+            Loader::NeoForge | Loader::Forge => Loader::Fabric,
+            other => other.clone(),
+        }
+    } else {
+        loader.clone()
+    }
