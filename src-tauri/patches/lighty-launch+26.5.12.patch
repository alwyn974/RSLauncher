+// Copyright (c) 2025 Hamadi
+// Licensed under the MIT License
+//
+// RSLauncher addition: host can register work that must finish after install
+// and before the JVM is spawned (mod reconcile, override re-apply, etc.).
+
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::RwLock;
+
+type BoxFuture = Pin<Box<dyn Future<Output = ()> + Send>>;
+type HookFn = Box<dyn Fn() -> BoxFuture + Send + Sync>;
+
+static PRE_LAUNCH_HOOK: RwLock<Option<HookFn>> = RwLock::new(None);
+
+/// Register a hook invoked after install / Forge processors and before the
+/// game process is spawned. Replaces any previous hook.
+pub fn set_pre_launch_hook<F, Fut>(hook: F)
+where
+    F: Fn() -> Fut + Send + Sync + 'static,
+    Fut: Future<Output = ()> + Send + 'static,
+{
+    let boxed: HookFn = Box::new(move || Box::pin(hook()));
+    if let Ok(mut slot) = PRE_LAUNCH_HOOK.write() {
+        *slot = Some(boxed);
+    }
+}
+
+pub(crate) async fn run_pre_launch_hook() {
+    let fut = {
+        let Ok(guard) = PRE_LAUNCH_HOOK.read() else {
+            return;
+        };
+        guard.as_ref().map(|hook| hook())
+    };
+    if let Some(fut) = fut {
+        fut.await;
+    }
+}
